# P1 EKF3 source sets, layered on top of base.parm.
# Set 1 is used at boot; MAV_CMD_SET_EKF_SOURCE_SET (param1 = 1..3) switches.
# Source codes: 0 none, 1 baro/compass, 2 rangefinder, 3 GPS, 5 optical flow.

# Set 1 - normal flight on GPS
EK3_SRC1_POSXY  3
EK3_SRC1_VELXY  3
EK3_SRC1_POSZ   1
EK3_SRC1_VELZ   3
EK3_SRC1_YAW    1

# Set 2 - GPS-denied backup: velocity from optical flow (scaled by the
# rangefinder), no horizontal position source so position dead-reckons and
# drifts. Height stays on baro - the rangefinder sees racks in the warehouse.
EK3_SRC2_POSXY  0
EK3_SRC2_VELXY  5
EK3_SRC2_POSZ   1
EK3_SRC2_VELZ   0
EK3_SRC2_YAW    1

# Only fuse the active set's velocity source - don't blend GPS and flow
EK3_SRC_OPTIONS 0
